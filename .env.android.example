# ==============================================================================
# CONFIGURAÇÃO ANDROID WHALEBONE CHECK (.env.android.example)
# Copie para .env.android (ou .env) e ajuste os valores conforme necessário.
# ==============================================================================

# Apps a testar no Android (nomes amigáveis ou package names separados por vírgula/espaço)
# Padrão: reddit, instagram, netflix
ANDROID_APPS=reddit, instagram, netflix

# URLs para testar no Google Chrome (se omitido, usa DEFAULT_URLS ou DOMAINS do .env)
# ANDROID_URLS=https://www.google.com, https://malware.test.attacker.online, https://phishing.test.attacker.online

# Backend de execução: auto | termux | adb
ANDROID_BACKEND=auto

# Tempos de espera em segundos
ANDROID_APP_WAIT=5
ANDROID_PAGE_WAIT=6

# Verificações a executar
ANDROID_CHECK_PRIVATE_DNS=true
ANDROID_CHECK_CHROME=true
ANDROID_SIMULATE_SCROLL=true

# Diretório de saída opcional (ex: ~/storage/downloads/android_results)
# ANDROID_OUTPUT_DIR=
