# ==============================================================================
# CONFIGURAÇÃO DNS WHALEBONE CHECK (.env.example)
# Copie para .env e ajuste os valores conforme o seu ambiente
# ==============================================================================

# 1. Lista de servidores DNS utilizados (separados por vírgula ou espaço)
DNS_SERVERS=10.36.41.114, 8.8.8.8

# (Opcional) Customizar os IPs padrão de cada Use Case do menu:
USE_CASE_1_DNS=10.36.41.114, 8.8.8.8
USE_CASE_2_DNS=10.36.41.115, 8.8.8.8
USE_CASE_3_DNS=10.36.41.116, 8.8.8.8

# 2. Lista de domínios ou URLs a serem testados (separados por vírgula ou espaço)
DOMAINS=https://www.google.com, https://malware.test.attacker.online, https://c2server.test.attacker.online, https://spam.test.attacker.online, https://phishing.test.attacker.online, https://coinminer.test.attacker.online, https://www.lovehoney.com, https://www.erowid.org

# 3. Arquivamento do resultado ao terminar (opções: none, tar, zip)
ARCHIVE_FORMAT=tar

# 4. Transferência automática via SCP ao terminar (true ou false)
SCP_ENABLED=false

# 5. Dados do servidor remoto de destino para SCP
SCP_HOST=192.168.1.50
SCP_PORT=22
SCP_USER=usuario
SCP_PATH=~/
# SCP_PASSWORD=  # Opcional: se deixado em branco, será solicitado de forma oculta (getpass) no terminal

# 6. Executar direto com os parâmetros do .env sem abrir o menu interativo (true ou false)
AUTO_RUN=false
