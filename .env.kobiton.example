# ==============================================================================
# CONFIGURAÇÃO KOBITON WHALEBONE CHECK (.env.kobiton.example)
# Copie para .env.kobiton (ou .env) e ajuste os valores conforme o seu ambiente.
# ==============================================================================

# Credenciais e endpoint do Kobiton
KOBITON_USERNAME=seu_usuario_kobiton
KOBITON_API_KEY=sua_api_key_kobiton
KOBITON_SERVER_URL=https://api.kobiton.com/wd/hub
KOBITON_API_URL=https://api.kobiton.com/v1

# Seleção do(s) dispositivo(s) Android no Kobiton (UDID único ou lista separada por vírgula)
# KOBITON_UDID=129b5649
# KOBITON_UDIDS=129b5649, R5CT123456
# KOBITON_TARGET_MSISDN=+351912345678
# KOBITON_DEVICE_NAME=Galaxy S23
# KOBITON_PLATFORM_VERSION=14
KOBITON_DEVICE_GROUP=KOBITON
KOBITON_SESSION_NAME=Whalebone DNS Check
# KOBITON_GROUP_ID=

# Servidores DNS destino para teste de conectividade após re-registro do SIM1
KOBITON_DNS_SERVERS=10.36.41.114, 8.8.8.8

# IPs de resposta DNS que confirmam bloqueio Whalebone/NOS (padrão: 212.113.177.247)
KOBITON_BLOCK_IPS=212.113.177.247

# Desativar Wi-Fi no Android durante os testes (força uso da rede móvel SIM1) e restaurar ao final
KOBITON_DISABLE_WIFI_DURING_TESTS=true

# Alterar temporariamente o DNS/Private DNS no Android (e restaurar ao final)
KOBITON_SET_ANDROID_DNS=false

# Tempos de espera (s) no ciclo Modo Avião ON -> OFF para deregistro/registro do SIM1
KOBITON_AIRPLANE_WAIT_ON=4
KOBITON_AIRPLANE_WAIT_OFF=10

# Apps e URLs a testar (mesmo padrão de .env.android.example)
KOBITON_APPS=reddit, instagram, netflix
# KOBITON_URLS=https://www.google.com, https://malware.test.attacker.online, https://phishing.test.attacker.online

# Tempos de espera em segundos
KOBITON_APP_WAIT=5
KOBITON_PAGE_WAIT=6

# Verificações
KOBITON_CHECK_PRIVATE_DNS=true
KOBITON_CHECK_CHROME=true
KOBITON_SIMULATE_SCROLL=true

# Diretório de saída opcional
# KOBITON_OUTPUT_DIR=
